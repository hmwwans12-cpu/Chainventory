# ============================================================================
# Chainventory — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# PUBLIC (browser-safe)  → NEXT_PUBLIC_*
# SERVER-ONLY (secrets)  → everything else. Never expose to the browser.
# ============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (https://supabase.com) ---
# Project URL + publishable key are public (used by the browser client).
# Supabase's new key model (2026): publishable (sb_publishable_...) replaces
# the legacy anon key; secret (sb_secret_...) replaces service_role.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback (deprecated by end of 2026) — uncomment only if needed:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret key — SERVER-ONLY. Never expose. Never use for user requests.
# REQUIRED in production (fail-fast, see lib/env.ts fix A7).
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy fallback (deprecated by end of 2026):
# SUPABASE_SERVICE_ROLE_KEY=
# Supabase Management API — tooling only (RBAC contract test / migrations).
# NOT required for app runtime.
# SUPABASE_MANAGEMENT_TOKEN=
# SUPABASE_PROJECT_REF=

# --- Privy (https://privy.io) — wallet layer only ---
NEXT_PUBLIC_PRIVY_APP_ID=
# SERVER-ONLY — used to verify custom-auth tokens from Supabase sessions.
PRIVY_APP_SECRET=

# --- Blockchain — Base Sepolia (chainId 84532) ---
BASE_SEPOLIA_RPC_URL=https://base-sepolia.drpc.org
BASE_SEPOLIA_RPC_FALLBACK_URL=https://sepolia.base.org
# Factory contract address (deployed via Foundry; see supabase/contracts)
WAREHOUSE_FACTORY_ADDRESS=

# --- Treasury signer (SERVIDER-ONLY) ---
# EOA private key that pays deployment/proof gas. Owns NO warehouse.
TREASURY_PRIVATE_KEY=

# --- BaseScan API (SERVER-ONLY) ---
# Used only by deployment tooling (forge verify-contract) to verify contract
# source on BaseScan so the "View on BaseScan" CTA in the UI (DESIGN section 39)
# shows verified source, not just bytecode. Get one free at:
#   https://basescan.org/apis  (BaseScan account -> API-KEYs tab)
BASESCAN_API_KEY=

# --- Upstash QStash (async proof delivery) ---
QSTASH_TOKEN=
# Optional override for non-Vercel regions; defaults to https://qstash.upstash.io
# QSTASH_URL=https://qstash.upstash.io
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional explicit base URL for QStash delivery (E2E tunnel override).
# If empty, falls back to NEXT_PUBLIC_APP_URL then VERCEL_URL (see lib/proof/qstash.ts).
# QSTASH_APP_BASE_URL=
# Injected automatically by Vercel per deployment — do NOT set manually.
# VERCEL_URL=

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Developer Console allowlist (comma-separated user ids) ---
DEVELOPER_ALLOWLIST=

# --- Resend (email invites, SERVER-ONLY, optional) ---
# Bila absen, undangan tetap tercatat; UI fallback ke salin link manual.
# RESEND_API_KEY=re_...
# RESEND_FROM=Chainventory <onboarding@resend.dev>

# --- Vercel Cron keep-alive (ARSITEKTUR §7.3) ---
# SERVER-ONLY. Sent by Vercel Cron as `Authorization: Bearer <CRON_SECRET>`.
# Verified by /api/internal/keep-alive. Generate a long random value (>=16 chars).
CRON_SECRET=

# --- Logging ---
LOG_LEVEL=info

# --- CI / preview only ---
# Set to 1 to bypass fail-fast validation for builds without live secrets.
# NEVER set in production Vercel env.
# SKIP_ENV_VALIDATION=
